# --- Local development ---

# Convex deployment URL (set by `npx convex dev`)
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Admin dashboard password. Set the same value in Convex via:
#   npx convex env set ADMIN_SECRET "<same value>"
ADMIN_SECRET=your-secure-admin-password

# Secret pepper for HMAC-SHA256 IP hashing (server-side only).
# Changing this invalidates existing ipHash values in the database.
IP_HASH_SECRET=your-ip-hash-pepper

# Proves a public Convex write came through this server, so a visitor cannot
# call comments.create / likes.setLike straight at the deployment with an
# ipHash of their choosing. NOT the admin password — it grants no bypass.
# Set the same value in Convex via:
#   npx convex env set BACKEND_WRITE_SECRET "<same value>"
BACKEND_WRITE_SECRET=your-backend-write-secret

# Shared key for the Apple Health API. The iOS Shortcut sends it as
# `Authorization: Bearer <key>`, and /health uses it server-side to read.
# Set the same value in Convex via:
#   npx convex env set HEALTH_API_KEY "<same value>"
HEALTH_API_KEY=your-health-api-key

# Optional. Convex HTTP actions live on the `.site` twin of PUBLIC_CONVEX_URL,
# which is derived automatically — set this only to override that.
# CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Vercel (set in the project's Environment Variables, not in this file) ---
#
# CONVEX_DEPLOY_KEY    Production deploy key from the Convex dashboard.
#                      Required by `npx convex deploy` during the build.
#                      The deploy command sets PUBLIC_CONVEX_URL automatically,
#                      so you do NOT need to set PUBLIC_CONVEX_URL on Vercel.
#
# ADMIN_SECRET         Same value as locally. Must match the Convex env
#                      (`npx convex env set ADMIN_SECRET ... --prod`).
#
# IP_HASH_SECRET       Required for Vite build (imported via $env/static/private).
#                      Must be set on Vercel Production and Preview.
#
# BACKEND_WRITE_SECRET Same value as in the Convex env
#                      (`npx convex env set BACKEND_WRITE_SECRET ... --prod`).
#                      Required for the Vite build (imported via
#                      $env/static/private), so set it on Production and Preview.
#
# HEALTH_API_KEY       Same value as in the Convex env. Read at runtime via
#                      $env/dynamic/private, so the build succeeds without it —
#                      /health just renders empty until it's set.

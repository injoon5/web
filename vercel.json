{
	"buildCommand": "npx convex deploy --cmd 'npx turbo run build-image-cache apply-optimized-images build'",
	"redirects": [
		{
			"source": "/.well-known/webfinger",
			"destination": "https://mastodon.injoon5.com/.well-known/webfinger",
			"permanent": true
		},
		{
			"source": "/internal/rss.xml",
			"destination": "/rss.xml",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/",
			"has": [
				{
					"type": "header",
					"key": "accept",
					"value": ".*text/markdown.*"
				}
			],
			"destination": "/api/markdown?path=/"
		},
		{
			"source": "/:path((?!api/|_app/|images/|videos/).*)",
			"has": [
				{
					"type": "header",
					"key": "accept",
					"value": ".*text/markdown.*"
				}
			],
			"destination": "/api/markdown?path=/:path"
		}
	],
	"headers": [
		{
			"source": "/.well-known/webfinger",
			"headers": [
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				}
			]
		},
		{
			"source": "/(images|videos)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}

{
	"buildCommand": "npx convex deploy --cmd 'npx turbo run build-image-cache apply-optimized-images build'",
	"redirects": [
		{
			"source": "/.well-known/webfinger",
			"destination": "https://mastodon.injoon5.com/.well-known/webfinger",
			"permanent": true
		},
		{
			"source": "/internal/rss.xml",
			"destination": "/rss.xml",
			"permanent": true
		},
		{
			"source": "/:kind(blog|projects)/:slug([a-z0-9-]+)",
			"has": [
				{
					"type": "query",
					"key": "lang",
					"value": "en"
				}
			],
			"destination": "/:kind/:slug/en",
			"permanent": true
		},
		{
			"source": "/:kind(blog|projects)/:slug([a-z0-9-]+)",
			"has": [
				{
					"type": "cookie",
					"key": "preferred-lang",
					"value": "en"
				}
			],
			"missing": [
				{
					"type": "query",
					"key": "lang"
				}
			],
			"destination": "/:kind/:slug/en",
			"permanent": false
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
				}
			]
		},
		{
			"source": "/.well-known/webfinger",
			"headers": [
				{
					"key": "Access-Control-Allow-Origin",
					"value": "*"
				}
			]
		},
		{
			"source": "/(images|videos)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/fonts/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/rss.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/rss+xml; charset=utf-8"
				}
			]
		}
	]
}

{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// The project is deliberately plain JS (no annotations — see CLAUDE.md),
		// so strict-checking .js/.svelte scripts only produces implicit-any noise
		// that buries real errors. Files that opt in with `// @ts-check` (the
		// security-relevant src/lib/server/* modules) stay fully checked.
		"checkJs": false,
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "vite.config.ts"]
}

{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"packageManager": "npm@10.9.7",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"build-image-cache": "node scripts/optimize-images.mjs",
		"apply-optimized-images": "node scripts/apply-optimized-images.mjs",
		"fingerprint-images": "node scripts/fingerprint-images.mjs",
		"code-theme": "node scripts/code-theme.mjs",
		"optimize-images": "turbo run build-image-cache apply-optimized-images",
		"deploy": "bash scripts/deploy.sh",
		"preview": "vite preview",
		"test": "svelte-kit sync && vitest run && npm run test:extension",
		"test:watch": "svelte-kit sync && vitest",
		"test:extension": "node --test 'tools/vscode-extension/src/**/*.test.js'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@eslint/js": "^10.0.1",
		"@pierre/highlights": "^0.2.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"convex-test": "^0.0.64",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"katex": "^0.19.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex-svelte": "^1.2.0",
		"rehype-slug": "^6.0.0",
		"remark-footnotes": "^2.0.0",
		"remark-math": "^3.0.1",
		"remark-parse": "^11.0.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"turbo": "^2.11.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"unified": "^11.0.5",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"@convex-dev/rate-limiter": "^0.4.2",
		"@lucide/svelte": "^1.61.0",
		"@resvg/resvg-js": "^2.6.2",
		"@videojs/html": "^10.2.0",
		"bcryptjs": "^3.0.3",
		"convex": "^1.47.0",
		"convex-svelte": "^0.15.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"dialkit": "^2.0.2",
		"dompurify": "^3.4.17",
		"layerchart": "^2.8.1",
		"marked": "^18.1.1",
		"mdast-util-to-string": "^4.0.0",
		"motion": "^14.6.0",
		"number-flow": "^0.6.2",
		"onedollarstats": "^0.0.23",
		"rehype-external-links": "^3.0.0",
		"rehype-figure": "^1.0.1",
		"remark-gemoji": "^8.0.0",
		"satori": "~0.32.0",
		"web-haptics": "^0.0.6",
		"xmlbuilder2": "^4.0.3",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#convex/*": "./convex/*"
	},
	"overrides": {
		"runed": {
			"@sveltejs/kit": "$@sveltejs/kit"
		},
		"rehype-katex-svelte": {
			"katex": "$katex"
		},
		"@tailwindcss/typography": {
			"postcss-selector-parser": "^7.1.7"
		}
	}
}

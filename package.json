{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"packageManager": "npm@10.9.7",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"build-image-cache": "node scripts/optimize-images.mjs",
		"apply-optimized-images": "node scripts/apply-optimized-images.mjs",
		"fingerprint-images": "node scripts/fingerprint-images.mjs",
		"optimize-images": "turbo run build-image-cache apply-optimized-images",
		"deploy": "bash scripts/deploy.sh",
		"preview": "vite preview",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@edge-runtime/vm": "^5.0.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.1.2",
		"convex-test": "^0.0.54",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex-svelte": "^1.2.0",
		"rehype-pretty-code": "^0.14.5",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-math": "^3.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sharp": "^0.35.3",
		"shiki": "^4.4.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.4.1",
		"turbo": "^2.10.8",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"unified": "^11.0.5",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"type": "module",
	"dependencies": {
		"@convex-dev/rate-limiter": "^0.3.2",
		"@lucide/svelte": "^1.28.0",
		"@number-flow/svelte": "^0.4.2",
		"@remark-embedder/core": "^3.0.3",
		"@remark-embedder/transformer-oembed": "^5.0.0",
		"@resvg/resvg-js": "^2.6.2",
		"bcryptjs": "^3.0.3",
		"convex": "^1.43.0",
		"convex-svelte": "^0.14.0",
		"d3-scale": "^4.0.2",
		"dialkit": "^1.4.3",
		"dompurify": "^3.4.13",
		"layerchart": "^2.0.4",
		"marked": "^18.0.7",
		"mdast-util-to-string": "^4.0.0",
		"motion": "^12.43.0",
		"onedollarstats": "^0.0.23",
		"rehype-external-links": "^3.0.0",
		"rehype-figure": "^1.0.1",
		"remark-gemoji": "^8.0.0",
		"remark-gfm": "^4.0.0",
		"satori": "^0.29.0",
		"web-haptics": "^0.0.6",
		"xmlbuilder2": "^4.0.3",
		"zod": "^4.4.3"
	},
	"overrides": {
		"cookie": "^0.7.2"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}

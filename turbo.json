{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": [
		"ADMIN_SECRET",
		"CONVEX_DEPLOY_KEY",
		"IP_HASH_SECRET",
		"PUBLIC_CONVEX_URL"
	],
	"tasks": {
		"fingerprint-images": {
			// Reads image bytes out of `git show HEAD:`, which turbo cannot see, so
			// no input glob describes what this task depends on. It is also ~1s.
			// Always run it, and let its output — a content hash per tracked image —
			// be the cache key for the expensive task below.
			//
			// The commit SHA is deliberately NOT in the hash, here or in globalEnv.
			// It changes on every deploy, and anything it touches can never hit the
			// remote cache: that is what made every deploy re-encode all 108 images.
			"cache": false,
			"outputs": [".cache/source-fingerprints.json"]
		},
		"build-image-cache": {
			"dependsOn": ["fingerprint-images"],
			"inputs": [".cache/source-fingerprints.json", "scripts/optimize-images.mjs"],
			"outputs": [".cache/image-optimize.json", ".cache/image-mirror/**"],
			"env": [
				"IMAGE_MAX_WIDTH",
				"IMAGE_MAX_HEIGHT",
				"JPEG_QUALITY",
				"PNG_COMPRESSION",
				"WEBP_QUALITY"
			]
		},
		"apply-optimized-images": {
			"dependsOn": ["build-image-cache"],
			"cache": false
		},
		"build": {
			"dependsOn": ["apply-optimized-images"],
			"outputs": [".svelte-kit/**", ".vercel/**"],
			"env": ["PUBLIC_CONVEX_URL", "ADMIN_SECRET", "CONVEX_DEPLOY_KEY", "IP_HASH_SECRET"]
		}
	}
}
